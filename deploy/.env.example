# Copy to .env and fill in (setup.sh creates it for you on the server).

# Domain pointing to the server's IP address, e.g. a free DuckDNS subdomain
DOMAIN=rohs-checker.duckdns.org

# Image version: "latest" follows main; a release number (e.g. 2.0.0) stays fixed until you change it
APP_VERSION=latest

# Required to edit the component database from the interface or the API (X-Admin-Token header).
# Generate one with: openssl rand -hex 24
RRC_ADMIN_TOKEN=

# Optional: enables AI extraction of PDF datasheets (Claude)
ANTHROPIC_API_KEY=
